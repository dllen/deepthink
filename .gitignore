# Generated assets
src/assets/static-data-*.json

# One-off migration backups and reports (local only)
python_scripts/backups/

# Database files
# NOTE: the plaintext python_scripts/web_content.db is intentionally NOT tracked.
# Only the encrypted copy (web_content.db.enc) is committed; CI decrypts it with
# the SQLITE_KEY secret. Local dev keeps the plaintext, ignored by *.db below.
*.db
*.sqlite
*.sqlite3

# Python virtual environments
.venv/
venv/
*.egg-info/

# pip
pip-log.txt
pip-delete-this-directory.txt

# npm lockfile — intentionally not tracked. CI resolves deps from
# the public registry via `npm install` (no `npm ci`). Re-adding
# package-lock.json would re-pin internal registry URLs that GH
# runners cannot reach.
package-lock.json

.superpowers/
