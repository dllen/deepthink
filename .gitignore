# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*
!.env.example

# Editors
.vscode/
.idea/

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
dist/
build/
target/
.gradle/

# System files
.DS_Store
Thumbs.db

# Compiled files
*.pyc
*.class
*.o
*.exe
*.dll
*.so
*.a
*.obj
*.out

# Coverage
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
